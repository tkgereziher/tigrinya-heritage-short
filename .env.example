# Copy to .env and fill in. .env is git-ignored; never commit keys.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model IDs change often; `python film.py smoke` lists what your key can see.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TEXT_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
